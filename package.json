{
    "name": "approbiom",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.27.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "pnpm": ">=10"
    },
    "scripts": {
        "dev": "vite",
        "build:staging": "node scripts/build.mjs",
        "build:prod": "node scripts/promote.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "test:run": "vitest run",
        "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:run"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^8.0.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "3.9.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.1",
        "vitest": "^4.1.10"
    }
}
