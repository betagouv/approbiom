# Same image as Grist.gouv. Keep tag in sync with prod.
# see https://hub.docker.com/r/lasuite/grist/tags
GRIST_IMAGE_TAG=1.7.22-3
GRIST_DEFAULT_EMAIL=prenom.nom@exemple.gouv.fr
GRIST_SESSION_SECRET=change-moi

# Apple Silicon (arm64): the amd64 image is emulated and the gVisor sandbox cannot start.
# Uncomment to run formulas without the sandbox. Local dev only, never in prod.
# GRIST_SANDBOX_FLAVOR=unsandboxed